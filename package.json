{
  "name": "swarm-rebuild",
  "version": "0.2.2",
  "description": "Wipe a page to a blank canvas and let a swarm of multiplayer cursors rebuild it, live.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "engines": {
    "node": ">=26"
  },
  "keywords": [
    "animation",
    "dom",
    "cursor",
    "swarm",
    "canvas",
    "effect",
    "portfolio"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "demo": "vite demo --open",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"release-please-config.json\" \".release-please-manifest.json\" \"tsup.config.ts\" \"playwright.config.ts\"",
    "api-report": "node scripts/api-report.mjs",
    "api-report:check": "node scripts/api-report.mjs --check",
    "pack:check": "node scripts/pack-check.mjs",
    "prepublishOnly": "npm run build && npm run api-report:check",
    "prepare": "lefthook install",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@typescript/typescript6": "^6.0.2",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaximeBoulle/Swarm-Rebuild.git"
  },
  "homepage": "https://github.com/MaximeBoulle/Swarm-Rebuild#readme",
  "bugs": {
    "url": "https://github.com/MaximeBoulle/Swarm-Rebuild/issues"
  },
  "author": "Maxime Boulle",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
